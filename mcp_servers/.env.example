# 복사해서 .env로 쓴다:  cp .env.example .env
# 비밀값은 코드나 이미지에 넣지 않고 이 파일(.env, git 제외)로만 주입한다.
#   임의 값 만들기: python -c "import secrets;print(secrets.token_urlsafe(32))"

# PostgreSQL 비밀번호 (compose가 DATABASE_URL을 만들 때 쓴다). token_urlsafe 값만 쓴다(@ : / 가 있으면 접속이 깨짐)
POSTGRES_PASSWORD=
# 서버 안에서 psql로 붙을 호스트 포트(127.0.0.1에만 열림). 로컬 Postgres가 5433을 쓰면 바꾼다
POSTGRES_HOST_PORT=5433

# 시드 사용자(사번 1021 등)의 로그인 비밀번호. users.password에 평문으로 들어가므로 실제 쓰는 비밀번호를 넣지 않는다
SEED_USER_PASSWORD=

# 실행 토큰 서명 키. 두 MCP가 같은 값을 써야 한다. 32자 이상 임의 문자열
RUN_TOKEN_SECRET=

# 내부 API(/internal/*: 실행 토큰 발급, 평가 건 생성·상태 전환, 재적재 반영) 키. 백엔드·테스트 하네스만 안다
INTERNAL_API_KEY=

# 장애 주입 (명세 6.2): case = DB fault_injections 적용(테스트 모드), off = 끔
FAULT_MODE=case
# 추가 주입 계획(JSON 배열). 예: [{"work_id":"W-E2E-QT-08","target":"business-mcp.get_artifact_diff","times":1}]
FAULT_PLAN=

# rag-mcp 하이브리드 검색 기준. 키워드(BM25) 점수나 벡터 코사인 유사도 중 하나는 넘어야 결과로 낸다
RAG_MIN_SCORE=1.0
RAG_MIN_SIM=0.35
# Chroma 컬렉션 이름 접두어 (axeval_references 등)
CHROMA_COLLECTION_PREFIX=axeval_
# 호스트 8000 포트가 사용 중이면 8003 등으로 변경. 컨테이너 내부 포트는 8000 유지
CHROMA_HOST_PORT=8000

# Host 헤더 허용 목록(쉼표 구분). 비우면 DNS 리바인딩 보호 끔(내부망 전제). 예: business-mcp:8001,localhost:8001
ALLOWED_HOSTS=

# true면 요청마다 독립 처리(세션 없음). LangGraph 등에서 호출마다 연결해도 된다
MCP_STATELESS=true
LOG_LEVEL=INFO

# ─── 로컬 LLM: GPU 서버에서 docker compose --profile llm 으로 띄울 때만 필요 ───
VLLM_TAG=v0.31.0
LLM_MODEL=cyankiwi/gemma-4-26B-A4B-it-AWQ-4bit
# 팀원 .env의 OPENAI_MODEL에 넣을 이름
SERVED_MODEL_NAME=gemma4
# 24GB GPU에서 메모리가 부족하면 16384로 줄인다
MAX_MODEL_LEN=32768
TOOL_CALL_PARSER=gemma4
# 비공개(gated) 모델을 받을 때만 필요
HF_TOKEN=
# vLLM 키. llm-proxy만 알고 팀원에게는 주지 않는다(비어 있으면 llm-proxy가 시작을 거부)
VLLM_API_KEY=
# 호출 주체별 프록시 키 '이름:키,이름:키'. 이름이 llm_exchanges.member에 남는다
#   예: workspace-backend:키1,eval-agent:키2,dev-hyeongjun:키3
PROXY_KEYS=
# 프록시가 vLLM 응답을 기다리는 최대 시간(초)
UPSTREAM_TIMEOUT=600
# 프록시 포트(4000)를 열 주소. EC2에서는 Tailscale IP(100.x.y.z)로 바꾸면 사설망에서만 접속된다
PROXY_BIND=0.0.0.0
# 서버 안에서 vLLM을 직접 확인할 때 쓰는 호스트 포트(127.0.0.1에만 열림). Chroma(8000)와 겹치지 않게 둔다
VLLM_HOST_PORT=8010
# 검증(--profile test)의 종단 시험이 LLM 응답을 기다리는 최대 시간(초). 첫 기동은 모델 다운로드·로딩으로 오래 걸린다
E2E_LLM_WAIT_SEC=900

# ─── 백엔드·RabbitMQ·중간 피드백 Worker: docker-compose.app.yml을 같이 줄 때만 필요 (docs/deploy_server.md) ───
# 서버에서는 주석을 풀면 docker compose가 두 파일을 같이 읽는다
# COMPOSE_FILE=docker-compose.yml:docker-compose.app.yml
# 백엔드 저장소(aworko-server) 경로. mcp_servers 기준 상대 경로(이 저장소와 나란히 받았으면 그대로)
BACKEND_DIR=../../aworko-server
# 백엔드 포트(8080)를 열 주소. 앞단에 리버스 프록시를 두면 127.0.0.1로 바꾼다
BACKEND_BIND=0.0.0.0
# 백엔드 JWT 서명 키. 32바이트 이상 임의 문자열
JWT_SECRET=
# Swagger UI(/swagger-ui.html) 공개 여부
SWAGGER_ENABLED=true
# RabbitMQ 계정(백엔드·Worker가 같이 씀). 비밀번호는 token_urlsafe 값만 쓴다(AMQP 주소에 들어감)
RABBITMQ_USERNAME=axeval
RABBITMQ_PASSWORD=
# RabbitMQ 관리 화면 호스트 포트(127.0.0.1에만 열림)
RABBITMQ_UI_PORT=15672
# Worker → business-mcp 토큰(kind=live, 회사 범위, 기본 30일). business-mcp가 뜬 뒤 발급해 넣는다(만료되면 다시 발급)
FEEDBACK_MCP_TOKEN=
# Worker → llm-proxy 키. PROXY_KEYS에도 feedback-worker:<같은 값>을 넣는다
FEEDBACK_LLM_API_KEY=
# Worker가 붙을 LLM 주소·모델. 비우면 http://llm-proxy:4000/v1과 SERVED_MODEL_NAME(서버 vLLM)
# OpenAI로 돌릴 때: FEEDBACK_LLM_BASE_URL=https://api.openai.com/v1, FEEDBACK_LLM_MODEL=gpt-4o-mini, FEEDBACK_LLM_API_KEY=OpenAI 키
FEEDBACK_LLM_BASE_URL=
FEEDBACK_LLM_MODEL=
# 백엔드(업무 공간 대화) → llm-proxy 키. PROXY_KEYS에도 workspace-backend:<같은 값>을 넣는다
WORKSPACE_LLM_API_KEY=
# 이미지 태그(로컬 빌드면 그대로)
BACKEND_TAG=local
WORKER_TAG=local
