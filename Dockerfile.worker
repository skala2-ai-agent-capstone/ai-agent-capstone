# 중간 피드백 Worker (python -m ai_agents.cli.feedback worker). 빌드 컨텍스트는 저장소 루트.
# 시작할 때 git으로 코드 출처(커밋·작업 트리 해시)를 기록하므로 git과 .git을 이미지에 넣는다.
# 일반 clone에서 빌드한다(git worktree는 .git이 파일이라 이미지 안에서 git이 실패한다).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-worker.txt .
# 맨 앞의 -e .(이 저장소)는 PYTHONPATH로 대신하고 고정된 의존성만 먼저 설치한다(레이어 캐시)
RUN grep -v '^-e ' requirements-worker.txt > /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt

COPY . .
# 소유자가 다른 저장소에서 git이 거부하지 않도록 safe.directory를 등록한다.
# 볼륨을 붙일 자리는 app 소유로 미리 만든다(새 이름 있는 볼륨이 이 소유권을 이어받는다).
# 최종 평가·팀 평가·기준 생성 Worker도 같은 이미지
RUN useradd --system --uid 10001 app \
    && mkdir -p outputs/feedback-traces outputs/final-checkpoints outputs/final-worker-traces outputs/run-tokens \
       outputs/team-checkpoints outputs/team-worker-traces outputs/rubric-traces \
    && chown -R app outputs \
    && git config --system --add safe.directory /app
USER app

CMD ["python", "-m", "ai_agents.cli.feedback", "worker", "--trace-dir", "outputs/feedback-traces"]
