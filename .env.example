# 복사하여 .env에 설정하세요. 실제 키를 Git에 커밋하지 마세요.
OPENAI_API_KEY=
# Responses API + Structured Outputs를 지원하며 계정에서 사용 가능한 모델
OPENAI_MODEL=gpt-4o-mini

# 업무 분류·승인 Agent → MCP (루트 .env에 추가, 실제 키/토큰은 Git에 올리지 않음)
BUSINESS_MCP_URL=http://localhost:8001/mcp
RAG_MCP_URL=http://localhost:8002/mcp
# 개발용 --evaluation-id 발급에만 사용. mcp_servers/.env의 값과 같아야 함
INTERNAL_API_KEY=
# 백엔드가 발급한 토큰을 직접 사용하려면 --work-id와 함께 설정
MCP_RUN_TOKEN=

# --trace-dir로 로컬 추적. --langsmith를 명시한 실행만 정제된 추적을 전송합니다.
# 원문·토큰은 기록하지 않습니다. LangGraph 자동 state 추적은 이 실행 범위에서 끕니다.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sales-ai-evaluation

# 버튼 요청형 중간 피드백. Chat Completions + JSON mode 호환 모델 주소를 명시.
FEEDBACK_LLM_BASE_URL=
FEEDBACK_LLM_MODEL=
FEEDBACK_LLM_API_KEY=
# 새 start_live_evaluation/get_messages/save_live_evaluation 도구가 있는 MCP 서버.
# 기존 최종 평가 토큰을 재사용하지 말고 MCP 담당자가 발급한 Worker 자격증명 사용.
FEEDBACK_MCP_URL=
FEEDBACK_MCP_TOKEN=
# worker 추가 의존성 설치: uv sync --locked --extra worker --inexact
FEEDBACK_AMQP_URL=
# 고정 가상 대화 품질 실험에서만 사용. FeedbackRubric JSON 파일 경로.
# Worker는 이 파일 대신 MCP에서 고정한 평가 기준을 사용합니다.
FEEDBACK_RUBRIC_FILE=

# 저장된 평가 기준으로 최종 평가 후 MCP 초안·코칭 저장 (cli.final_evaluation)
# 명시적인 자체 호스팅 모델/프록시 주소가 필수. 기본 OpenAI 주소로 폴백하지 않음.
FINAL_LLM_BASE_URL=
FINAL_LLM_MODEL=
FINAL_LLM_API_KEY=
FINAL_BUSINESS_MCP_URL=http://localhost:8001/mcp
FINAL_RAG_MCP_URL=http://localhost:8002/mcp
# 해당 평가 건에 귀속된 evaluation 토큰. 중간 피드백 Worker 토큰을 재사용하지 않음.
FINAL_MCP_TOKEN=
# 최종 평가 Worker용 RabbitMQ. 큐 계약은 CLI --contract로 선택.
FINAL_AMQP_URL=

# MCP 없는 고정 가상 입력 평가. cli.quality run에서만 실제 모델을 호출합니다.
# OpenAI 호환 /v1 주소. 중간 피드백: JSON mode, 최종 평가: JSON Schema 지원 필요.
QUALITY_LLM_BASE_URL=
QUALITY_LLM_MODEL=
QUALITY_LLM_API_KEY=
# 재현을 위한 배포 모델/가중치 버전. 미설정 시 unspecified로 기록.
QUALITY_MODEL_REVISION=

# 공개된 팀 집계로 코칭 생성 (cli.team_evaluation run). 개인 원문은 입력하지 않음.
TEAM_LLM_BASE_URL=
TEAM_LLM_MODEL=
TEAM_LLM_API_KEY=
TEAM_MODEL_REVISION=

