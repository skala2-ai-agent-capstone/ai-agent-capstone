            "type": "string"
          },
          "status_label": {
            "minLength": 1,
            "title": "Status Label",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "maximum": 2,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
